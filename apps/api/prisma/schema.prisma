// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cities                    City[]
  users                     User[]
  parkingZones              ParkingZone[]
  parkingSpaces             ParkingSpace[]
  vehicles                  Vehicle[]
  parkingRates              ParkingRate[]
  parkingSessions           ParkingSession[]
  paymentMethods            PaymentMethod[]
  payments                  Payment[]
  inspectors                Inspector[]
  fineTypes                 FineType[]
  fines                     Fine[]
  enforcementCases          EnforcementCase[]
  cameras                   Camera[]
  cameraEvents              CameraEvent[]
  cameraEventsRaw           CameraEventRaw[]
  cameraSnapshots           CameraSnapshot[]
  parkingSpaceStatusHistory ParkingSpaceStatusHistory[]
  alerts                    Alert[]
  auditLogs                 AuditLog[]
  cameraGroups              CameraGroup[]
  cameraStallMappings       CameraStallMapping[]

  @@map("tenants")
}

model City {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  code      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                    Tenant                      @relation(fields: [tenantId], references: [id])
  users                     User[]
  parkingZones              ParkingZone[]
  parkingSpaces             ParkingSpace[]
  vehicles                  Vehicle[]
  parkingRates              ParkingRate[]
  parkingSessions           ParkingSession[]
  payments                  Payment[]
  inspectors                Inspector[]
  fines                     Fine[]
  enforcementCases          EnforcementCase[]
  cameras                   Camera[]
  cameraEvents              CameraEvent[]
  parkingSpaceStatusHistory ParkingSpaceStatusHistory[]
  alerts                    Alert[]
  cameraGroups              CameraGroup[]
  cameraStallMappings       CameraStallMapping[]

  @@unique([tenantId, code])
  @@map("cities")
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  cityId    String?
  email     String   @unique
  name      String
  password  String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  city   City?  @relation(fields: [cityId], references: [id])

  userRoles  UserRole[]
  auditLogs  AuditLog[]
  zoneAccess UserZoneAccess[]

  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserZoneAccess {
  id        String   @id @default(uuid())
  userId    String
  zoneId    String
  createdAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id])
  zone ParkingZone @relation(fields: [zoneId], references: [id])

  @@unique([userId, zoneId])
  @@map("user_zone_access")
}

model ParkingZone {
  id        String   @id @default(uuid())
  tenantId  String
  cityId    String
  name      String
  code      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  city   City   @relation(fields: [cityId], references: [id])

  spaces              ParkingSpace[]
  inspectors          Inspector[]
  cameras             Camera[]
  userZoneAccess      UserZoneAccess[]
  cameraGroups        CameraGroup[]
  cameraStallMappings CameraStallMapping[]

  @@unique([cityId, code])
  @@index([tenantId])
  @@map("parking_zones")
}

model ParkingSpace {
  id        String   @id @default(uuid())
  tenantId  String
  cityId    String
  zoneId    String
  code      String
  label     String?
  type      String   @default("vehicle")
  status    String   @default("available")
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant              Tenant                      @relation(fields: [tenantId], references: [id])
  city                City                        @relation(fields: [cityId], references: [id])
  zone                ParkingZone                 @relation(fields: [zoneId], references: [id])
  sessions            ParkingSession[]
  cameraEvents        CameraEvent[]
  statusHistory       ParkingSpaceStatusHistory[]
  alerts              Alert[]
  cameraStallMappings CameraStallMapping[]

  @@unique([zoneId, code])
  @@index([tenantId])
  @@map("parking_spaces")
}

model Vehicle {
  id          String   @id @default(uuid())
  tenantId    String
  cityId      String
  plateNumber String
  ownerName   String?
  ownerPhone  String?
  ownerEmail  String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  city             City              @relation(fields: [cityId], references: [id])
  sessions         ParkingSession[]
  fines            Fine[]
  enforcementCases EnforcementCase[]

  @@unique([tenantId, plateNumber])
  @@map("vehicles")
}

model ParkingRate {
  id             String   @id @default(uuid())
  tenantId       String
  cityId         String
  name           String
  code           String
  currency       String   @default("USD")
  pricePerMinute Float
  minimumMinutes Int      @default(15)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  city   City   @relation(fields: [cityId], references: [id])

  @@unique([cityId, code])
  @@index([tenantId])
  @@map("parking_rates")
}

model ParkingSession {
  id        String    @id @default(uuid())
  tenantId  String
  cityId    String
  spaceId   String
  vehicleId String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  status    String    @default("active")
  amount    Float     @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  city     City         @relation(fields: [cityId], references: [id])
  space    ParkingSpace @relation(fields: [spaceId], references: [id])
  vehicle  Vehicle      @relation(fields: [vehicleId], references: [id])
  payments Payment[]
  fines    Fine[]

  @@index([tenantId])
  @@map("parking_sessions")
}

model PaymentMethod {
  id          String   @id @default(uuid())
  tenantId    String
  code        String
  name        String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  payments Payment[]

  @@unique([tenantId, code])
  @@map("payment_methods")
}

model Payment {
  id              String   @id @default(uuid())
  tenantId        String
  cityId          String
  sessionId       String?
  paymentMethodId String
  amount          Float
  currency        String   @default("USD")
  status          String   @default("paid")
  reference       String?
  paidAt          DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  city          City            @relation(fields: [cityId], references: [id])
  session       ParkingSession? @relation(fields: [sessionId], references: [id])
  paymentMethod PaymentMethod   @relation(fields: [paymentMethodId], references: [id])

  @@index([tenantId])
  @@map("payments")
}

model Inspector {
  id             String   @id @default(uuid())
  tenantId       String
  cityId         String
  assignedZoneId String?
  name           String
  email          String?
  phone          String?
  deviceId       String?
  shift          String   @default("mixto")
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  city             City              @relation(fields: [cityId], references: [id])
  assignedZone     ParkingZone?      @relation(fields: [assignedZoneId], references: [id])
  fines            Fine[]
  enforcementCases EnforcementCase[]

  @@index([tenantId])
  @@map("inspectors")
}

model FineType {
  id          String   @id @default(uuid())
  tenantId    String
  code        String
  name        String
  description String?
  amount      Float
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  fines  Fine[]

  @@unique([tenantId, code])
  @@map("fine_types")
}

model Fine {
  id          String    @id @default(uuid())
  tenantId    String
  cityId      String
  sessionId   String?
  vehicleId   String?
  inspectorId String?
  fineTypeId  String
  plateNumber String
  amount      Float
  status      String    @default("pending")
  priority    String    @default("medium")
  evidenceUrl String?
  observation String?
  issuedAt    DateTime  @default(now())
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  city      City            @relation(fields: [cityId], references: [id])
  session   ParkingSession? @relation(fields: [sessionId], references: [id])
  vehicle   Vehicle?        @relation(fields: [vehicleId], references: [id])
  inspector Inspector?      @relation(fields: [inspectorId], references: [id])
  fineType  FineType        @relation(fields: [fineTypeId], references: [id])

  @@index([tenantId])
  @@map("fines")
}

model EnforcementCase {
  id          String    @id @default(uuid())
  tenantId    String
  cityId      String
  inspectorId String?
  vehicleId   String?
  plateNumber String
  issue       String
  status      String    @default("pending")
  priority    String    @default("medium")
  detectedAt  DateTime  @default(now())
  resolvedAt  DateTime?
  observation String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  city      City       @relation(fields: [cityId], references: [id])
  inspector Inspector? @relation(fields: [inspectorId], references: [id])
  vehicle   Vehicle?   @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@map("enforcement_cases")
}

/// Catalog of supported camera manufacturers/protocols — platform-level,
/// not tenant-scoped. One row per provider adapter actually implemented
/// in code (e.g. DAHUA_ITSAPI). Seeded in a later commit, not this one.
///
/// Deliberately has no healthCheckEndpoint (or any active/pull health
/// mechanism): Dahua ITSAPI is push-only — the camera calls the gateway,
/// never the other way around — so health is derived passively from
/// KeepAlive traffic and Camera.lastSeenAt, never polled. A future
/// pull-based provider (e.g. ONVIF) may need one; see
/// docs/architecture/iot-device-management-foundation.md §15.
model CameraProvider {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  protocol          String
  /// TODO (deuda técnica, no implementar ahora): hoy las capacidades del
  /// proveedor (LPR, snapshots, occupancy, etc.) y la versión de
  /// protocolo/firmware quedan libres dentro de este JSON. Evaluar
  /// modelarlas como columnas/tablas estructuradas cuando exista un
  /// segundo fabricante real y se sepa qué campos realmente varían entre
  /// proveedores — evita comprometerse hoy a una estructura basada en
  /// un solo caso (Dahua) sin evidencia de un segundo caso.
  capabilities      Json
  defaultAuthMode   String
  /// Relative path templates per canonical event type (see
  /// core/contracts/canonical-camera-event.ts CanonicalCameraEventType),
  /// not per manufacturer-specific name — composed by the future
  /// BackOffice as gateway.publicBaseUrl + gateway.basePath +
  /// provider.endpointTemplates[eventType]. Only canonical event types
  /// with a real, implemented route belong here — never list an event
  /// type as if it were operative before its controller route and
  /// business treatment actually exist (see AlarmInfo, still pending).
  endpointTemplates Json
  /// Manufacturer protocol documentation — informational only, no
  /// behavior depends on it.
  documentationUrl  String?
  /// Manufacturer support/contact — informational only, no behavior
  /// depends on it.
  supportUrl        String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  gateways CameraGateway[]
  cameras  Camera[]

  @@map("camera_providers")
}

/// Technical entry point for a provider's traffic. Deliberately separate
/// from CameraProvider so a provider could have more than one gateway in
/// the future without a redesign — see
/// docs/architecture/iot-device-management-foundation.md §6-7.
model CameraGateway {
  id             String   @id @default(uuid())
  providerId     String
  code           String   @unique
  name           String
  protocol       String
  publicBaseUrl  String
  privateBaseUrl String?
  basePath       String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider CameraProvider @relation(fields: [providerId], references: [id])
  cameras  Camera[]
  groups   CameraGroup[]

  @@index([providerId])
  @@map("camera_gateways")
}

/// Operational grouping of cameras by business criteria (site, install
/// batch) — distinct from ParkingZone (a geographic/business concept).
/// Structure only in this commit; no consumers in code yet.
model CameraGroup {
  id          String   @id @default(uuid())
  tenantId    String
  cityId      String
  zoneId      String?
  gatewayId   String?
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  city    City           @relation(fields: [cityId], references: [id])
  zone    ParkingZone?   @relation(fields: [zoneId], references: [id])
  gateway CameraGateway? @relation(fields: [gatewayId], references: [id])
  cameras Camera[]

  @@index([tenantId])
  @@index([cityId])
  @@map("camera_groups")
}

model Camera {
  id        String   @id @default(uuid())
  tenantId  String?
  cityId    String?
  zoneId    String?
  code      String?
  name      String?
  location  String?
  latitude  Float?
  longitude Float?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deviceId           String    @unique
  channel            Int       @default(0)
  manufacturer       String?
  model              String?
  firmwareVersion    String?
  ipAddress          String?
  macAddress         String?
  lastSeenAt         DateTime?
  registrationStatus String    @default("pending_review")
  authMode           String    @default("ip_allowlist")

  /// Nullable in this commit — backfilled in a later commit once
  /// CameraProvider is seeded (Commit 6). deviceId stays globally
  /// @unique for now; migrating to @@unique([providerId, deviceId])
  /// is deferred to the same later commit, once providerId is
  /// guaranteed populated. See
  /// docs/architecture/iot-device-management-foundation.md §14.
  providerId String?
  gatewayId  String?
  groupId    String?

  tenant        Tenant?              @relation(fields: [tenantId], references: [id])
  city          City?                @relation(fields: [cityId], references: [id])
  zone          ParkingZone?         @relation(fields: [zoneId], references: [id])
  provider      CameraProvider?      @relation(fields: [providerId], references: [id])
  gateway       CameraGateway?       @relation(fields: [gatewayId], references: [id])
  group         CameraGroup?         @relation(fields: [groupId], references: [id])
  events        CameraEvent[]
  rawEvents     CameraEventRaw[]
  alerts        Alert[]
  stallMappings CameraStallMapping[]

  @@index([tenantId])
  @@index([tenantId, cityId])
  @@index([providerId])
  @@index([gatewayId])
  @@index([groupId])
  @@map("cameras")
}

/// Explicit, administrable link between what a camera reports
/// (externalStallCode, in the manufacturer's own vocabulary) and the real
/// ParkingSpace — never the internal ParkingSpace UUID inside the camera.
/// Created in this commit but NOT wired into the occupancy resolution
/// flow yet — CameraIngestionCoreService keeps using the direct
/// (zoneId, code) lookup unchanged. See
/// docs/architecture/iot-device-management-foundation.md §9, §14.
model CameraStallMapping {
  id                String   @id @default(uuid())
  tenantId          String
  cityId            String
  zoneId            String
  cameraId          String
  externalStallCode String
  parkingSpaceId    String?
  /// DISCOVERED | MAPPED | ACTIVE | DISABLED | CONFLICT
  mappingStatus     String   @default("DISCOVERED")
  firstReportedAt   DateTime @default(now())
  lastReportedAt    DateTime @default(now())
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  city         City          @relation(fields: [cityId], references: [id])
  zone         ParkingZone   @relation(fields: [zoneId], references: [id])
  camera       Camera        @relation(fields: [cameraId], references: [id])
  parkingSpace ParkingSpace? @relation(fields: [parkingSpaceId], references: [id])

  @@unique([cameraId, externalStallCode])
  @@index([parkingSpaceId])
  @@index([mappingStatus])
  @@index([tenantId])
  @@index([cityId])
  @@map("camera_stall_mappings")
}

model CameraEvent {
  id          String   @id @default(uuid())
  tenantId    String
  cityId      String
  cameraId    String
  plateNumber String?
  eventType   String
  confidence  Float?
  metadata    Json?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  parkingSpaceId String?
  detectionScope String
  idempotencyKey String  @unique
  rawEventId     String

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  city         City             @relation(fields: [cityId], references: [id])
  camera       Camera           @relation(fields: [cameraId], references: [id])
  parkingSpace ParkingSpace?    @relation(fields: [parkingSpaceId], references: [id])
  rawEvent     CameraEventRaw   @relation(fields: [rawEventId], references: [id])
  snapshots    CameraSnapshot[]

  @@index([tenantId, cityId, occurredAt])
  @@index([parkingSpaceId])
  @@map("camera_events")
}

model CameraEventRaw {
  id               String    @id @default(uuid())
  tenantId         String?
  cameraId         String?
  deviceIdRaw      String
  eventType        String
  payload          Json
  contextIp        String
  contextHeaders   Json
  receivedAt       DateTime  @default(now())
  validationStatus String
  processingStatus String    @default("PENDING")
  processedAt      DateTime?
  error            String?

  tenant Tenant?       @relation(fields: [tenantId], references: [id])
  camera Camera?       @relation(fields: [cameraId], references: [id])
  events CameraEvent[]

  @@index([processingStatus, receivedAt])
  @@index([tenantId])
  @@map("camera_events_raw")
}

model CameraSnapshot {
  id            String   @id @default(uuid())
  tenantId      String
  cameraEventId String
  kind          String
  storageUrl    String?
  width         Int?
  height        Int?
  contentType   String   @default("image/jpeg")
  capturedAt    DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  cameraEvent CameraEvent @relation(fields: [cameraEventId], references: [id])

  @@index([cameraEventId])
  @@index([tenantId])
  @@map("camera_snapshots")
}

model ParkingSpaceStatusHistory {
  id             String   @id @default(uuid())
  tenantId       String
  cityId         String
  spaceId        String
  previousStatus String
  newStatus      String
  source         String
  sourceEventId  String?
  changedAt      DateTime @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  city   City         @relation(fields: [cityId], references: [id])
  space  ParkingSpace @relation(fields: [spaceId], references: [id])

  @@index([spaceId, changedAt])
  @@index([tenantId])
  @@map("parking_space_status_history")
}

model Alert {
  id             String    @id @default(uuid())
  tenantId       String
  cityId         String
  type           String
  cameraId       String?
  parkingSpaceId String?
  status         String    @default("OPEN")
  payload        Json
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?
  closedAt       DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  city         City          @relation(fields: [cityId], references: [id])
  camera       Camera?       @relation(fields: [cameraId], references: [id])
  parkingSpace ParkingSpace? @relation(fields: [parkingSpaceId], references: [id])

  @@index([tenantId, status])
  @@map("alerts")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  userId     String?
  action     String
  entity     String
  entityId   String?
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("audit_logs")
}
