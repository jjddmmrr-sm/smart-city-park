# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (see https://pris.ly/d/connection-strings)
DATABASE_URL="postgresql://user:password@localhost:5432/smart_city_platform"

# Secret used to sign/verify JWTs. Required - the API refuses to start
# without it. Generate one with: openssl rand -hex 32
JWT_SECRET=""

# Optional, defaults to 3000
PORT=3000
